<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".home.views.HomeFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlways">

            <TextView
                android:id="@+id/app_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/action_favourite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:padding="8dp"
                android:src="@drawable/ic_round_favorite_border_24"
                app:layout_constraintEnd_toStartOf="@+id/action_settings"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/action_settings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:src="@drawable/ic_round_settings_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/action_search_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/shape_action_search"
                android:drawableStart="@drawable/ic_round_search_24"
                android:drawablePadding="8dp"
                android:drawableTint="@color/white"
                android:hint="@string/search_wallpapers"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLength="100"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/white"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/app_name_tv" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <HorizontalScrollView
            android:id="@+id/primary_filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            app:layout_scrollFlags="scroll|enterAlways">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/primary_filter_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_trending"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/trending"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_latest"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/latest"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipIconVisible="false" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/category_filter_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:scrollbars="none"
            app:layout_scrollFlags="scroll|enterAlways">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/category_filter_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_backgrounds"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/backgrounds"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_fashion"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fashion"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_nature"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nature"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_science"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/science"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_education"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/education"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_feelings"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/feelings"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_health"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/health"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_people"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/people"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_religion"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/religion"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_places"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/places"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_animals"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/animals"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_industry"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/industry"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_computer"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/computer"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_food"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/food"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_sports"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sports"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_transportation"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/transportation"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_travel"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/travel"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_buildings"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buildings"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_business"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/business"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_music"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/music"
                    android:textColor="@color/chip_text_selector"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/chip_background_selector" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/home_swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/home_wallpaper_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/network_error_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="invisible"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_group_4network_error_white" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:text="@string/swipe_to_refresh"
            android:textColor="@color/white"
            android:textSize="28sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView" />

        <TextView
            android:id="@+id/no_photos_found_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/no_wallpaper_found"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/home_progress_bar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>